{
  "name": "afterimage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "build:skin": "tsc --noEmit && vite build --config vite.skin.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@videojs/html": "10.4.0",
    "@videojs/mux-video": "10.4.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "license": "Apache-2.0",
  "description": "AFTERIMAGE: a darkroom-inspired Video.js 10 player skin."
}
